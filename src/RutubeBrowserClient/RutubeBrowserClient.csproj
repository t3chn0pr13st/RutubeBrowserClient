<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>RutubeBrowserClient</PackageId>
    <Version>0.1.7</Version>
    <Authors>technopriest</Authors>
    <Product>RutubeBrowserClient</Product>
    <Description>Unofficial .NET client for an authenticated Rutube Studio account with portable browser sessions, VOD operations, and a typed live-stream lifecycle.</Description>
    <PackageTags>rutube;studio;video;live;streaming;unofficial;playwright</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/t3chn0pr13st/RutubeBrowserClient</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/t3chn0pr13st/RutubeBrowserClient</PackageProjectUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RutubeBrowserClient.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
